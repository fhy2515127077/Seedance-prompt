VITE_APP_BASE_PATH=/

# Only used in local development. Vite should proxy /api to your own backend.
VITE_DEV_PROXY_TARGET=http://127.0.0.1:8787

# Backend-only secrets. Do not expose these through VITE_ variables.
SEEDANCE_ADMIN_PASSWORD=change-this-password

# Prompt optimization provider
SEEDANCE_ENDPOINT=https://api.gemai.cc/v1
SEEDANCE_API_KEY=
SEEDANCE_MODEL=deepseek-chat

# Image generation provider
SEEDANCE_IMAGE_ENDPOINT=https://grsai.dakka.com.cn
SEEDANCE_IMAGE_API_KEY=
SEEDANCE_IMAGE_MODEL=gpt-image-2
SEEDANCE_IMAGE_SIZE=auto
